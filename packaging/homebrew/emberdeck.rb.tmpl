# typed: false
# frozen_string_literal: true

# This file is generated by scripts/render-formula.mjs during a release.
# Source: https://github.com/alexandercreates/emberdeck/tree/main/packaging/homebrew
class Emberdeck < Formula
  desc "Manage Firebase Remote Config and Storage across stages with typed items"
  homepage "https://github.com/alexandercreates/emberdeck"
  version "{{version}}"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/alexandercreates/emberdeck/releases/download/v{{version}}/emberdeck-v{{version}}-darwin-arm64.tar.gz"
      sha256 "{{sha256_darwin_arm64}}"
    end
    on_intel do
      url "https://github.com/alexandercreates/emberdeck/releases/download/v{{version}}/emberdeck-v{{version}}-darwin-x64.tar.gz"
      sha256 "{{sha256_darwin_x64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/alexandercreates/emberdeck/releases/download/v{{version}}/emberdeck-v{{version}}-linux-arm64.tar.gz"
      sha256 "{{sha256_linux_arm64}}"
    end
    on_intel do
      url "https://github.com/alexandercreates/emberdeck/releases/download/v{{version}}/emberdeck-v{{version}}-linux-x64.tar.gz"
      sha256 "{{sha256_linux_x64}}"
    end
  end

  def install
    bin.install "emberdeck"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/emberdeck --version")
  end
end
